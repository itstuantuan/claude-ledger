# Real Go backend (base includes API version). Set the exact deployed API URL.
NEXT_PUBLIC_API_MODE=real
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1

# For local mock preview only: set MODE=mock, leave BASE_URL empty.
# Production builds reject mock unless this explicit local-only override is set.
# ALLOW_LOCAL_MOCK_BUILD=true
